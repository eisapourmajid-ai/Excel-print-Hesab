@echo off
chcp 65001 >nul
title سامانه حسابداری و ادغام اکسل مازندشت — مدیریت قاسم زاهدی
color 0A

echo ======================================================================
echo    شرکت سورتینگ و بسته‌بندی مرکبات مازندشت (مدیریت قاسم زاهدی)
echo    سامانه یکپارچه ورود، پردازش و ادغام فایل‌های اکسل
echo ======================================================================
echo.

:: بررسی وجود پایتون
python --version >nul 2>&1
if %errorlevel% neq 0 (
    echo [خطا] پایتون روی این سیستم شناسایی نشد!
    echo لطفاً پایتون ۳.۸.۱۰ (سازگار با ویندوز ۷) را نصب نموده و تیک "Add Python to PATH" را بزنید.
    echo فایل راهنمای "راهنمای_اجرا_ویندوز۷.txt" را مطالعه فرمایید.
    echo.
    pause
    exit /b 1
)

echo [۱/۳] در حال بررسی پیش‌نیازهای نرم‌افزار...
python -c "import fastapi, uvicorn, openpyxl, pandas" >nul 2>&1
if %errorlevel% neq 0 (
    echo در حال نصب پکیج‌های موردنیاز از فایل requirements.txt...
    pip install -r requirements.txt
)

echo [۲/۳] راه‌اندازی سرور اختصاصی مازندشت روی پورت 8000...
echo برنامه به صورت کاملاً آفلاین و محلی (بدون نیاز به اینترنت) اجرا می‌شود.
echo.

start "" http://127.0.0.1:8000

echo [۳/۳] سامانه با موفقیت در مرورگر باز شد.
echo این پنجره را تا زمان استفاده از نرم‌افزار نبندید.
echo برای خروج از برنامه، کلیدهای Ctrl + C را فشار دهید.
echo ======================================================================
echo.

python -m uvicorn app.main:app --host 127.0.0.1 --port 8000
pause
